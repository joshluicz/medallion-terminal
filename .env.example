# Medallion Terminal — Environment Variables
# Copy this to .env.local and fill in values. NEVER commit .env.local to git.

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (Auth) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Market Data ────────────────────────────────────────────────────────────
# Free tier: leave POLYGON blank, data fetcher uses yfinance Python script
# Paid tier: get key from polygon.io
POLYGON_API_KEY=

# ── IBKR ───────────────────────────────────────────────────────────────────
# IBKR Client Portal API runs locally on port 5000 by default
# See: https://github.com/InteractiveBrokers/cpwebapi
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
